#!/usr/bin/env bash
#
# gh bootstrap-repo — secure-by-default settings for a GitHub repo.
#
# Template repos copy files, not settings. Run this once per new repo.
# Safe to re-run: every step is idempotent (the ruleset is updated in place).
#
# Usage:
#   gh bootstrap-repo <owner/repo> [--checks "build,test"] [--no-codeql] [--no-actions-allowlist] [--no-require-signed]
#
#   --checks               Comma-separated status checks required on the default branch
#                          (job names as they appear in the PR checks list).
#   --no-codeql            Skip CodeQL default setup (use if the repo has its own CodeQL workflow).
#   --no-actions-allowlist Don't restrict Actions to GitHub-owned and verified creators.
#   --no-require-signed    Don't require signed commits on the default branch.
#                          (Squash merges made on github.com are signed by GitHub.)
#
# Requires: gh (authenticated, admin on the repo), jq.
#
# Note: on private repos some features need a paid plan (rulesets on personal
# accounts need Pro; secret scanning/code scanning need GitHub Secret/Code
# Protection). Those steps are reported as skipped and the script carries on.

set -uo pipefail

REPO=""
CHECKS=""
CODEQL=1
ACTIONS_ALLOWLIST=1
REQUIRE_SIGNED=1
RULESET_NAME="secure-default-branch"

usage() { sed -n '2,22p' "$0" | sed 's/^# \{0,1\}//'; exit 1; }

while [[ $# -gt 0 ]]; do
  case "$1" in
    --checks) CHECKS="${2:-}"; shift 2 ;;
    --no-codeql) CODEQL=0; shift ;;
    --no-actions-allowlist) ACTIONS_ALLOWLIST=0; shift ;;
    --no-require-signed) REQUIRE_SIGNED=0; shift ;;
    -h|--help) usage ;;
    -*) echo "Unknown option: $1" >&2; usage ;;
    *) REPO="$1"; shift ;;
  esac
done

[[ -z "$REPO" ]] && usage
command -v gh >/dev/null || { echo "gh is not installed" >&2; exit 1; }
command -v jq >/dev/null || { echo "jq is not installed" >&2; exit 1; }
gh auth status >/dev/null 2>&1 || { echo "gh is not authenticated (gh auth login)" >&2; exit 1; }

OK=0; SKIPPED=0

# step "<description>" gh api ...
step() {
  local desc="$1"; shift
  local out
  if out=$("$@" 2>&1); then
    printf '  \e[32m✓\e[0m %s\n' "$desc"; OK=$((OK+1))
  else
    local msg
    msg=$(jq -r '.message? // empty' <<<"$out" 2>/dev/null | head -1)
    [[ -z "$msg" ]] && msg=$(tail -1 <<<"$out")
    printf '  \e[33m⚠\e[0m %s — skipped: %s\n' "$desc" "$msg"; SKIPPED=$((SKIPPED+1))
  fi
}

REPO_JSON=$(gh api "repos/$REPO") || { echo "Cannot read $REPO" >&2; exit 1; }
VISIBILITY=$(jq -r .visibility <<<"$REPO_JSON")
DEFAULT_BRANCH=$(jq -r .default_branch <<<"$REPO_JSON")
IS_ADMIN=$(jq -r .permissions.admin <<<"$REPO_JSON")

[[ "$IS_ADMIN" != "true" ]] && { echo "You need admin rights on $REPO" >&2; exit 1; }

echo "Bootstrapping $REPO ($VISIBILITY, default branch: $DEFAULT_BRANCH)"

# --- Repository settings -----------------------------------------------------
echo "Repository"
step "Squash merge only, PR title as commit message" \
  gh api -X PATCH "repos/$REPO" -F allow_squash_merge=true -F allow_merge_commit=false -F allow_rebase_merge=false \
    -f squash_merge_commit_title=PR_TITLE -f squash_merge_commit_message=BLANK

step "Delete head branches after merge" \
  gh api -X PATCH "repos/$REPO" -F delete_branch_on_merge=true

step "Require sign-off on web-based commits" \
  gh api -X PATCH "repos/$REPO" -F web_commit_signoff_required=true

# --- Dependencies -------------------------------------------------------------
echo "Dependencies"
step "Dependabot alerts" \
  gh api -X PUT "repos/$REPO/vulnerability-alerts"

step "Dependabot security updates" \
  gh api -X PUT "repos/$REPO/automated-security-fixes"

# --- Secrets ------------------------------------------------------------------
echo "Secrets"
step "Secret scanning" \
  gh api -X PATCH "repos/$REPO" --input - <<<'{"security_and_analysis":{"secret_scanning":{"status":"enabled"}}}'

step "Secret scanning push protection" \
  gh api -X PATCH "repos/$REPO" --input - <<<'{"security_and_analysis":{"secret_scanning_push_protection":{"status":"enabled"}}}'

# --- Code scanning ------------------------------------------------------------
echo "Code scanning"
if [[ $CODEQL -eq 1 ]]; then
  step "CodeQL default setup" \
    gh api -X PATCH "repos/$REPO/code-scanning/default-setup" --input - <<<'{"state":"configured","query_suite":"default"}'
else
  echo "  - CodeQL default setup (disabled with --no-codeql)"
fi

# --- Vulnerability reporting --------------------------------------------------
if [[ "$VISIBILITY" == "public" ]]; then
  echo "Vulnerability reporting"
  step "Private vulnerability reporting" \
    gh api -X PUT "repos/$REPO/private-vulnerability-reporting"
fi

# --- GitHub Actions -----------------------------------------------------------
echo "Actions"
step "GITHUB_TOKEN read-only by default, cannot approve PRs" \
  gh api -X PUT "repos/$REPO/actions/permissions/workflow" --input - \
    <<<'{"default_workflow_permissions":"read","can_approve_pull_request_reviews":false}'

if [[ $ACTIONS_ALLOWLIST -eq 1 ]]; then
  # shellcheck disable=SC2329 # invoked via step
  allow_selected_actions() {
    gh api -X PUT "repos/$REPO/actions/permissions" --input - <<<'{"enabled":true,"allowed_actions":"selected"}' &&
    gh api -X PUT "repos/$REPO/actions/permissions/selected-actions" --input - \
      <<<'{"github_owned_allowed":true,"verified_allowed":true,"patterns_allowed":[]}'
  }
  step "Allow only GitHub-owned and verified-creator actions" allow_selected_actions
else
  echo "  - Actions allowlist (disabled with --no-actions-allowlist)"
fi

# --- Default branch ruleset ---------------------------------------------------
echo "Default branch"
STATUS_RULE=""
if [[ -n "$CHECKS" ]]; then
  STATUS_RULE=$(jq -nc --arg c "$CHECKS" '{
    type: "required_status_checks",
    parameters: {
      strict_required_status_checks_policy: true,
      required_status_checks: ($c | split(",") | map(gsub("^\\s+|\\s+$"; "")) | map(select(length > 0)) | map({context: .}))
    }}')
fi

RULESET=$(jq -nc --arg name "$RULESET_NAME" --argjson status "${STATUS_RULE:-null}" --argjson signed "$REQUIRE_SIGNED" '{
  name: $name,
  target: "branch",
  enforcement: "active",
  conditions: { ref_name: { include: ["~DEFAULT_BRANCH"], exclude: [] } },
  bypass_actors: [ { actor_type: "RepositoryRole", actor_id: 5, bypass_mode: "pull_request" } ],
  rules: ([
    { type: "deletion" },
    { type: "non_fast_forward" },
    { type: "pull_request",
      parameters: {
        required_approving_review_count: 0,
        dismiss_stale_reviews_on_push: true,
        require_code_owner_review: false,
        require_last_push_approval: false,
        required_review_thread_resolution: true,
        allowed_merge_methods: ["squash"]
      } }
  ]
  + (if $signed == 1 then [{ type: "required_signatures" }] else [] end)
  + (if $status then [$status] else [] end))
}')

SIGNED_DESC=""; [[ $REQUIRE_SIGNED -eq 1 ]] && SIGNED_DESC=", signed commits"

EXISTING_ID=$(gh api "repos/$REPO/rulesets" 2>/dev/null \
  | jq -r --arg n "$RULESET_NAME" '.[]? | select(.name == $n) | .id' | head -1)

if [[ -n "$EXISTING_ID" ]]; then
  step "Update ruleset '$RULESET_NAME' (no deletion, no force push, squash PR required, admin bypass via PR${SIGNED_DESC}${CHECKS:+, checks: $CHECKS})" \
    gh api -X PUT "repos/$REPO/rulesets/$EXISTING_ID" --input - <<<"$RULESET"
else
  step "Create ruleset '$RULESET_NAME' (no deletion, no force push, squash PR required, admin bypass via PR${SIGNED_DESC}${CHECKS:+, checks: $CHECKS})" \
    gh api -X POST "repos/$REPO/rulesets" --input - <<<"$RULESET"
fi

echo
echo "Done: $OK applied, $SKIPPED skipped."
[[ $SKIPPED -gt 0 ]] && echo "Skipped steps usually mean the feature isn't available for this repo's plan or visibility."
exit 0
